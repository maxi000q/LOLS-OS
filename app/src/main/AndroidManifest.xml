<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- LOLS OS requires ZERO Android permissions by design.
         The virtual OS runs entirely inside the app sandbox:
         its filesystem, memory and processes are real but private. -->

    <application
        android:name=".LolsApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_lols"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LOLS">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
